#   vc_consensus-> claude-sonnet-4-6
# BRAINSTORM_MODEL=claude-opus-4-6
# PREMORTEM_MODEL=claude-sonnet-4-6
# EVOLUTION_MODEL=claude-sonnet-4-6
# VC_MATCH_MODEL=claude-haiku-4-5
# VC_EVAL_MODEL=claude-sonnet-4-6
# VC_CONSENSUS_MODEL=claude-sonnet-4-6
MAX_ITERATIONS=5
SCORE_THRESHOLD=80

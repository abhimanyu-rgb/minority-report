ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides. Defaults (from app/models_cfg.py):
#   brainstorm  -> claude-opus-4-6    (max model — Opus 4.7 capped out)
#   premortem   -> claude-sonnet-4-6
#   evolution   -> claude-sonnet-4-6
#   vc_match    -> claude-haiku-4-5   (cheap JSON pattern-match)
#   vc_eval     -> claude-sonnet-4-6
#   vc_consensus-> claude-sonnet-4-6
# BRAINSTORM_MODEL=claude-opus-4-6
# PREMORTEM_MODEL=claude-sonnet-4-6
# EVOLUTION_MODEL=claude-sonnet-4-6
# VC_MATCH_MODEL=claude-haiku-4-5
# VC_EVAL_MODEL=claude-sonnet-4-6
# VC_CONSENSUS_MODEL=claude-sonnet-4-6
MAX_ITERATIONS=3
SCORE_THRESHOLD=80

# Voyage AI embeddings (powers similarity / peer-run matching / corpora retrieval).
# Without this, runs still work but similarity features are silently disabled.
# Get a key at https://www.voyageai.com/
# VOYAGE_API_KEY=...
# VOYAGE_MODEL=voyage-3-lite

# Admin email gate (comma-separated). Defaults to abhimanyu@nurix.ai.
# ADMIN_EMAILS=abhimanyu@nurix.ai
